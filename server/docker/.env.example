# docker/.env — every app service (web, worker, beat). Copy to docker/.env on the server,
# fill in, chmod 600. Never commit the real file. NO Claude key here: it goes to
# docker/worker.env (worker only, TZ SEC-12).

DJANGO_SETTINGS_MODULE=yoriqnoma_server.settings.prod
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=yoriqnoma.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://yoriqnoma.example.uz
YORIQNOMA_PUBLIC_HOST=yoriqnoma.example.uz
YORIQNOMA_PUBLIC_URL=https://yoriqnoma.example.uz

POSTGRES_DB=yoriqnoma
POSTGRES_USER=yoriqnoma
POSTGRES_PASSWORD=
DATABASE_URL=postgres://yoriqnoma:CHANGE_ME@postgres:5432/yoriqnoma
REDIS_URL=redis://redis:6379/0
YORIQNOMA_RATELIMIT_REDIS_URL=redis://redis:6379/1

S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=https://files.yoriqnoma.example.uz
S3_BUCKET=yoriqnoma
S3_ACCESS_KEY=
S3_SECRET_KEY=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
YORIQNOMA_FERNET_KEY=
# a long random value (e.g. openssl rand -base64 48); replacing other people's data (FR-E10)
YORIQNOMA_PSEUDONYM_KEY=

YORIQNOMA_MAIL_DOMAIN=inbox.yoriqnoma.example.uz
YORIQNOMA_MAILPIT_URL=http://mailpit:8025

YORIQNOMA_MAX_CONCURRENT_JOBS=2
YORIQNOMA_RETENTION_DAYS=30
YORIQNOMA_DEFAULT_JOB_BUDGET_USD=3
YORIQNOMA_MAX_JOB_BUDGET_USD=20
YORIQNOMA_USER_DAILY_BUDGET_USD=10
YORIQNOMA_USER_MONTHLY_BUDGET_USD=50
YORIQNOMA_MONTHLY_BUDGET_USD=500

YORIQNOMA_MODEL_HAIKU=claude-haiku-5-5
YORIQNOMA_MODEL_SONNET=claude-sonnet-5-5
YORIQNOMA_MODEL_OPUS=claude-opus-5-5
# JSON, dollars per million tokens; empty keeps the built-in table
YORIQNOMA_PRICES=
